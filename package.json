{
  "name": "objects-tasks-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && stylelint 'src/**/*.scss'",
    "lint:fix": "eslint . --fix && stylelint 'src/**/*.scss' --fix",
